## EJERCICIO 2 Escribe factura(*precios, **opciones): acepta un número variable de precios con *args y \
# opciones con **kwargs. Suma el total, aplica un 21% de IVA si llega iva=True, y devuelve el texto "TOTAL MONEDA"\
#  con el total redondeado a 2 decimales y la moneda de opciones ("EUR" si no se indica). \ 
# Pruébala con factura(10, 20, 5), factura(10, 20, 5, iva=True) y factura(100, 50, iva=True, moneda="USD")

def factura(*precios, **opciones):
    total_precio = 0
    iva_perc = 0.21
    moneda_op = []
    iva_op = False
    # TODO: suma los precios que llegan en la tupla 'precios'
    total_precio = sum(precios)
    # TODO: si opciones trae iva, multiplica el total por 1.21
    iva_op = opciones.get("iva", False)
    if iva_op == True:
        total_precio = total_precio * (1+iva_perc)
    # TODO: coge la moneda de opciones ("EUR" si no viene)
    moneda_op = opciones.get("moneda","EUR")
    # TODO: devuelve el texto "TOTAL MONEDA", con el total redondeado a 2 decimales
    total_precio = round(total_precio,2)
    resultado = str(total_precio) + " " + moneda_op
    return resultado

# TODO: imprime factura(10, 20, 5), factura(10, 20, 5, iva=True)
#       y factura(100, 50, iva=True, moneda="USD")
factura(10,20,5)
factura(10,20,5,iva=True)
factura(100,50,iva=True,moneda="USD")


## EJERCICIO 3: Dos funciones de repaso: una con return de un valor y otra que devuelve varias salidas 
# (llegan como tupla y se pueden desempaquetar). 1) conversor_km_millas(distancia), 
# que devuelva 0.62 * distancia redondeado a 1 decimal; 2) minmax(numeros), que devuelva el mínimo y 
# el máximo de una lista de números. Pruébalas e imprime los resultados: por ejemplo con 100 km 
# y con la lista [22, 34, 15, 26, 18].

def conversor_km_millas(distancia):
    return round(0.62*distancia,1)

def minmax(numeros):
    return min(numeros), max(numeros)

distancia = conversor_km_millas(100)
print(distancia)

min_y_max = minmax([22, 34, 15, 26, 18])
print(min_y_max)